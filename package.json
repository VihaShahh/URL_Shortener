{
  "name": "url-shortner",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "npm run db:generate",
    "dev": "concurrently --kill-others --names client,server \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:browser": "npm run test:browser --workspace client",
    "test:stack": "node --env-file-if-exists=.env scripts/smoke-stack.mjs",
    "db:generate": "npm run prisma:generate --workspace server",
    "db:migrate": "npm run prisma:deploy --workspace server",
    "db:seed": "npm run seed --workspace server",
    "docker:up": "docker compose up --build --wait",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "10.0.6"
  }
}
